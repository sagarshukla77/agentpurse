# ---- Required ----
DATABASE_URL=postgres://agentpurse:agentpurse@localhost:5432/agentpurse
# Generate each secret with:  openssl rand -base64 32
SESSION_SECRET=
APPROVAL_SECRET=
ENCRYPTION_KEY=            # exactly 32 bytes, base64 (openssl rand -base64 32)

# ---- Demo conveniences (turn OFF for anything but a local demo) ----
DEMO_MODE=true                 # skips authenticator codes
NEXT_PUBLIC_DEMO_MODE=true     # shows demo account buttons on the login page
DEMO_PASSWORD=demo-password-change-me
PAYMENT_HOLD_SECONDS=20        # cancel window before money leaves (900 in real use)
INLINE_WORKER=true             # run the payment worker inside the web process

# ---- PayPal (sandbox only; the app refuses non-sandbox URLs) ----
PAYPAL_MODE=live               # "simulated" = no PayPal calls at all (UI development)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=AdOrBSn0kijs3fVMuG70R...
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Real sandbox payouts: set these to your sandbox PERSONAL account emails before `npm run db:seed`
DEMO_VENDOR_EMAIL_NORTHWIND=
DEMO_VENDOR_EMAIL_ACME=
DEMO_VENDOR_EMAIL_LUMEN=
DEMO_VENDOR_EMAIL_PIXEL=

# ---- AI ----
AI_MODE=mock                   # "mock" = offline parser for the fixture format; "anthropic" = Claude
ANTHROPIC_API_KEY=
MODEL_EXTRACT=                 # a current Claude model id (check the Anthropic docs)
MODEL_FAST=                    # a smaller, cheaper Claude model id
AI_MAX_CALLS_PER_DAY=300

# ---- Optional ----
CRON_SECRET=                   # lets an external scheduler call POST /api/worker/tick
NOTIFY_WEBHOOK_URL=            # Slack-compatible incoming webhook for alerts
STEP_UP_CENTS=50000            # approvals at/above this need a fresh authenticator code
REQUIRE_TOTP=true
